OPENAI_API_KEY=sk-...
SAMPLE_FPS=1
MAX_VIDEO_SIZE_MB=500
FACE_SIMILARITY_THRESHOLD=0.55
SAM3_CONFIDENCE_THRESHOLD=0.3
SAM3_MODE=normal
SAM3_MASK_INTERPOLATION_ENABLED=true
SAM3_MASK_LOWRES_MAX_SIDE=960
SAM3_MASK_KEYFRAME_INTERVAL=3
SAM3_MASK_DILATE_PX=24
BRAND_LOGO_DETECTION_ENABLED=true
MASK_PREVIEW_MAX_SIDE=960
DEBUG_MASK_OVERLAY=false
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
SAM3_CHECKPOINT=checkpoints/sam3.pt
